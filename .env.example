# This project is deployed to the cloud (no Docker in production). These
# variables are not read from a local .env file in production — set them
# directly in each platform's dashboard:
#
# Backend (Render)  -> Web Service -> Environment
# Frontend (netlify/Render Static Site) -> Environment Variables
DB_NAME=screening_platform
DB_PASSWORD=password
SECRET_KEY=change-this-to-a-long-random-string-in-production
